# .env file for environment variables

# ClickUp API Key and Team ID
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=

# Supabase Database URL and Service Role Key
SUPABASE_URL=
SUPABASE_KEY=

# AWS Account Information (root)
ACCOUNT_NAME=
ACCOUNT_ID=
EMAIL_ADRESS=
USER_ID=
AWS_ROOT_PASSWORD=

# AWS IAM Login (console)
URL=
IAM-USERNAME=
AWS_IAM_PASSWORD=

# AWS Access Key ID and Secret Access Key (used by Serverless Framework)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Serverless Framework AWS profile name (configured via `serverless config credentials --profile matte`)
AWS_PROFILE=

# Ubuntu Name and Password
USERNAME=
PASSWORD=

# Discord Webhook URL
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_ACOMPANHAMENTO=
